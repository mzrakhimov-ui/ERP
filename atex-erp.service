[Unit]
Description=A Tex Sanoat ERP Telegram Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/ERP
EnvironmentFile=/root/ERP/.env
ExecStart=/root/ERP/venv/bin/python Bot.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
